# Copy to deploy/.env on the server (chmod 600). Never commit the real file.
# Every value below is new: rotate everything the old Pi had (REBUILD_PLAN.md step 11).

# ── Cloudflare (free) ────────────────────────────────────────────────
# Zero Trust > Networks > Tunnels > Create tunnel > Docker: copy the token.
# Public hostname: core.aipaygen.com -> http://web:5001 (the Worker owns aipaygen.com, api., mcp.)
CLOUDFLARE_TUNNEL_TOKEN=

# Same value as the Worker's CORE_EDGE_SECRET (wrangler secret put CORE_EDGE_SECRET).
# With it set, the core rejects anything that didn't come through the Worker.
AIPAYGEN_EDGE_SECRET=

# R2 > Create bucket (e.g. aipaygen-backups) > Manage API tokens > Object Read & Write on that bucket.
R2_ACCOUNT_ID=
R2_BUCKET=aipaygen-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cloudflare Access in front of /admin (REBUILD_PLAN.md step 10)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
ADMIN_REQUIRE_CF_ACCESS=1

# ── App secrets ──────────────────────────────────────────────────────
# Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SECRET=
AIPAYGEN_IP_HASH_SECRET=
JWT_SECRET=
ADMIN_EMAIL=

# ── Providers (API keys only; never a personal subscription) ─────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

APIFY_API_TOKEN=
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=

# ── Sign-in (OAuth apps: new client secrets) ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Payments ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Same wallet the live v2 Worker pays into (PAY_TO). Base mainnet = eip155:8453.
WALLET_ADDRESS=
EVM_NETWORK=eip155:8453
FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
BASE_RPC_URL=https://mainnet.base.org

# ── Off until each is safe ───────────────────────────────────────────
# CODE_RUN_ENABLED=1   only inside an isolated sandbox (Phase 4)
