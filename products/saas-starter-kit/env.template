# ─────────────────────────────────────────────────────────
# SaaS Starter Kit — Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────

# App
APP_NAME=MySaaS
BASE_URL=https://yourdomain.com
SECRET_KEY=                          # python3 -c "import os; print(os.urandom(32).hex())"
ADMIN_SECRET=                        # Password for /admin routes
PORT=5000

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...      # From Stripe webhook dashboard

# Stripe Price IDs (create in Stripe Dashboard > Products)
STRIPE_PRICE_STARTER=price_...       # $29/mo starter plan
STRIPE_PRICE_PRO=price_...           # $79/mo pro plan
STRIPE_PRICE_BUSINESS=price_...      # $199/mo business plan

# Email (https://resend.com)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60             # Default requests/minute per API key
DAILY_SPEND_LIMIT_USD=50.0           # Max spend per key per day

# Database
DATABASE_PATH=./data/app.db          # SQLite database location
